# Elbservice Berichtsassistent – Beispielkonfiguration (nur Platzhalter, keine echten Zugangsdaten)
PORT=4200
HOST=127.0.0.1
DATABASE_URL=postgres://APP_USER:APP_PASSWORD@127.0.0.1:5432/elbservice_support

# Modellfunktion „service_report_summary“ (lokaler Simulator oder Gateway)
MODEL_ENDPOINT=http://127.0.0.1:4900/models/service-report

# Von Workbase gesetzt (optional)
WORKBASE_PROJECT=elbservice-support
WORKBASE_STAGE=dev
WORKBASE_DATASET_LABEL=
WORKBASE_COMMIT=

# Tests
WORKBASE_TEST_REPORT=.workbase/test-report.json
